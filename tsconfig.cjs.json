{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist/cjs",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,
    "removeComments": false,
    "stripInternal": true
  },
  "include": ["src"]
}
